<Window x:Class="AutopilotQuick.SecretUnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unlock AutopilotQuick" Width="500" SizeToContent="Height"
        Background="#3D3D3D" Foreground="White"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#555555"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="24">
        <TextBlock Text="Enter the archive passphrase to start AutopilotQuick." TextWrapping="Wrap" Margin="0,0,0,16"/>
        <PasswordBox x:Name="Passphrase" MaxLength="1024" IsEnabled="False" Foreground="White" Background="#292929" CaretBrush="White" BorderBrush="#AAAAAA" Margin="0,0,0,12"/>
        <CheckBox x:Name="DownloadLatest" Content="Download latest bundle (waits for internet)" Checked="DownloadLatest_Changed" Unchecked="DownloadLatest_Changed" Margin="0,0,0,12"/>
        <TextBlock Text="A cached encrypted bundle is used automatically when available." TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock x:Name="Status" Text="Preparing encrypted bundle..." TextWrapping="Wrap" MinHeight="64" Margin="0,0,0,12"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="Retry" Content="Retry" Width="90" Click="Retry_Click" Margin="0,0,8,0"/>
            <Button x:Name="Unlock" Content="Unlock" IsEnabled="False" IsDefault="True" Width="90" Click="Unlock_Click" Margin="0,0,8,0"/>
            <Button Content="Cancel" IsCancel="True" Width="90" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
